diff --git a/src/db/migration_006_eta_notifications.sql b/src/db/migration_006_eta_notifications.sql
new file mode 100644
index 0000000..aedbe0f
--- /dev/null
+++ b/src/db/migration_006_eta_notifications.sql
@@ -0,0 +1,58 @@
+-- ============================================================
+-- ETA-based "bus arriving in ~10 minutes" notifications
+-- ============================================================
+-- Replaces the fixed 500m proximity alarm with a time-based alert. Three
+-- backend-only tables (RLS enabled, zero policies — only the Node backend
+-- touches them via service_role):
+--
+--   route_segment_stats — learned stop-to-stop travel times
+--   trip_progress       — which stops a bus has reached on today's trip
+--   notification_log    — one row per alert sent; stops duplicates, survives restarts
+
+-- Learned travel time between two consecutive stops. Keyed by the stops'
+-- rounded coordinates (not their sequence number), so the learning survives
+-- a route regeneration as long as those two stops are still neighbours.
+-- avg_seconds INCLUDES boarding time at the "from" stop.
+create table if not exists route_segment_stats (
+  bus_id uuid not null references buses(id) on delete cascade,
+  route_type text not null check (route_type in ('pickup', 'drop')),
+  segment_key text not null,          -- "lat,lng>lat,lng" rounded to 4 decimals (~11m)
+  avg_seconds double precision not null,
+  samples int not null default 0,
+  updated_at timestamptz not null default now(),
+  primary key (bus_id, route_type, segment_key)
+);
+
+-- Progress of today's trip. Written only when the bus reaches a stop
+-- (not on every ping), so it's cheap, and it lets the backend resume
+-- correctly after a restart mid-trip.
+create table if not exists trip_progress (
+  bus_id uuid not null references buses(id) on delete cascade,
+  service_date date not null,         -- IST date
+  route_type text not null check (route_type in ('pickup', 'drop')),
+  visited jsonb not null default '{}'::jsonb,  -- { "<stop sequence>": "<ISO time reached>" }
+  anchor_index int,                   -- sequence of the most recent stop reached
+  anchor_at timestamptz,
+  updated_at timestamptz not null default now(),
+  primary key (bus_id, service_date, route_type)
+);
+
+-- One row per student per trip per alert kind. The unique key is what
+-- guarantees a parent never gets the same alert twice for the same trip.
+create table if not exists notification_log (
+  id bigserial primary key,
+  student_id uuid not null references students(id) on delete cascade,
+  bus_id uuid references buses(id) on delete set null,
+  service_date date not null,
+  route_type text not null check (route_type in ('pickup', 'drop')),
+  kind text not null default 'ARRIVING_SOON',
+  eta_seconds int,
+  sent_at timestamptz not null default now(),
+  unique (student_id, service_date, route_type, kind)
+);
+
+create index if not exists idx_notification_log_date on notification_log(service_date);
+
+alter table route_segment_stats enable row level security;
+alter table trip_progress enable row level security;
+alter table notification_log enable row level security;
diff --git a/src/eta/eta.test.js b/src/eta/eta.test.js
new file mode 100644
index 0000000..a208294
--- /dev/null
+++ b/src/eta/eta.test.js
@@ -0,0 +1,164 @@
+// Run: node src/eta/eta.test.js   (or: npm run test:eta)
+// No database or network needed — tests the pure ETA logic only.
+import assert from 'node:assert/strict';
+import {
+  DEFAULTS, normaliseStops, segmentKey, expectedLegSeconds,
+  detectArrival, computeEtas, learnLeg,
+} from './etaCalculator.js';
+import { groupIntoStops } from '../routes/stopOrdering.js';
+
+let passed = 0;
+function test(name, fn) {
+  fn();
+  passed++;
+  console.log(`  ✓ ${name}`);
+}
+
+// ~111m per 0.001° latitude. Stops laid out northward from Tirur-ish coords.
+const BASE = { lat: 10.9, lng: 75.92 };
+const north = (m) => ({ lat: BASE.lat + m / 111_320, lng: BASE.lng });
+
+console.log('ETA calculator');
+
+test('groups students within 50m into one stop', () => {
+  const stops = groupIntoStops([
+    { id: 'a', ...north(0) },
+    { id: 'b', ...north(30) },   // sibling next door
+    { id: 'c', ...north(400) },
+  ]);
+  assert.equal(stops.length, 2);
+  assert.deepEqual(stops[0].ids, ['a', 'b']);
+});
+
+test('old-format stop_sequence (student_id) still works', () => {
+  const s = normaliseStops([{ sequence: 0, student_id: 'x', lat: 1, lng: 2 }, { sequence: 1, student_id: null, lat: 1, lng: 3 }]);
+  assert.deepEqual(s[0].student_ids, ['x']);
+  assert.deepEqual(s[1].student_ids, []);
+});
+
+const stops = normaliseStops([
+  { sequence: 0, student_ids: ['s0'], ...north(0), baseline_leg_seconds: null },
+  { sequence: 1, student_ids: ['s1'], ...north(1000), baseline_leg_seconds: 180 },
+  { sequence: 2, student_ids: ['s2'], ...north(2000), baseline_leg_seconds: 180 },
+  { sequence: 3, student_ids: [], ...north(3000), baseline_leg_seconds: 180 }, // school
+]);
+const now = new Date('2026-09-28T02:00:00Z');
+
+test('leg time = Mapbox baseline + boarding time', () => {
+  assert.equal(expectedLegSeconds(stops, 2, new Map()), 180 + DEFAULTS.dwellSeconds);
+});
+
+test('learned time overrides Mapbox baseline', () => {
+  const learned = new Map([[segmentKey(stops[1], stops[2]), { avg_seconds: 400 }]]);
+  assert.equal(expectedLegSeconds(stops, 2, learned), 400);
+});
+
+test('ETA subtracts time already spent on the current leg', () => {
+  const anchor = { index: 0, at: new Date(now - 60_000) }; // left stop 0 a minute ago
+  const etas = computeEtas({ stops, visited: { 0: 'x' }, anchor, bus: north(300), now, learned: new Map() });
+  assert.equal(Math.round(etas.get(1)), 225 - 60);
+  assert.equal(Math.round(etas.get(2)), 165 + 225);
+  assert.equal(etas.has(3), false, 'school is never a notification target');
+});
+
+test('bus running late falls back to distance estimate', () => {
+  const anchor = { index: 0, at: new Date(now - 20 * 60_000) }; // stuck 20 min
+  const etas = computeEtas({ stops, visited: { 0: 'x' }, anchor, bus: north(500), now, learned: new Map() });
+  const expected = (500 * DEFAULTS.roadFactor) / (DEFAULTS.avgSpeedKmh / 3.6);
+  assert.ok(Math.abs(etas.get(1) - expected) < 5);
+});
+
+test('stop skipped by driver (behind the anchor) still gets an ETA', () => {
+  const anchor = { index: 2, at: now };
+  const etas = computeEtas({ stops, visited: { 0: 'x', 2: 'x' }, anchor, bus: north(2000), now, learned: new Map() });
+  assert.ok(etas.has(1));
+  assert.ok(etas.get(1) > 0);
+});
+
+test('arrival detected only within 100m, nearest stop wins', () => {
+  assert.equal(detectArrival(stops, {}, north(950)), 1);
+  assert.equal(detectArrival(stops, {}, north(850)), null);
+  assert.equal(detectArrival(stops, { 1: 'x' }, north(990)), null);
+});
+
+test('learning moves toward real time, ignores breakdowns', () => {
+  assert.equal(learnLeg(200, 300), 230);
+  assert.equal(learnLeg(200, 900), null); // 4.5x — outlier
+  assert.equal(learnLeg(null, 250), 250);
+});
+
+// ------------------------------------------------------------------
+// Simulated trip: 8 stops 800m apart, bus drives 18 km/h (slower than the
+// 20 km/h default) and waits 60s at each stop. Mapbox baseline is optimistic
+// (assumes 25 km/h). Check when the alert fires vs the real arrival time,
+// first with no history, then after 5 trips of learning.
+// ------------------------------------------------------------------
+console.log('\nSimulated trip (10s GPS pings)');
+
+function simulate(learned) {
+  const n = 8, gap = 800, speed = 18 / 3.6, dwell = 60, mapboxSpeed = 25 / 3.6;
+  const route = normaliseStops(Array.from({ length: n }, (_, i) => ({
+    sequence: i, student_ids: [`s${i}`], ...north(i * gap),
+    baseline_leg_seconds: i === 0 ? null : gap / mapboxSpeed,
+  })));
+
+  // Real timeline: bus starts 1500m before stop 0.
+  const arriveAt = [];
+  let t = 1500 / speed;
+  for (let i = 0; i < n; i++) { arriveAt.push(t); t += dwell + gap / speed; }
+  const posAt = (sec) => {
+    let m = -1500, clock = 0;
+    for (let i = 0; i < n; i++) {
+      const drive = (i === 0 ? 1500 : gap) / speed;
+      if (sec < clock + drive) return north(m + (sec - clock) * speed);
+      clock += drive; m += i === 0 ? 1500 : gap;
+      if (sec < clock + dwell) return north(m);
+      clock += dwell;
+    }
+    return north(m);
+  };
+
+  const start = Date.parse('2026-09-28T01:30:00Z');
+  const visited = {};
+  let anchor = null;
+  const firedAt = {};
+  const legs = [];
+  for (let sec = 0; sec < t; sec += 10) {
+    const bus = posAt(sec);
+    const nowD = new Date(start + sec * 1000);
+    const hit = detectArrival(route, visited, bus);
+    if (hit != null) {
+      if (anchor && hit === anchor.index + 1) legs.push([anchor.index, hit, (nowD - anchor.at) / 1000]);
+      visited[hit] = 'x';
+      anchor = { index: hit, at: nowD };
+    }
+    const etas = computeEtas({ stops: route, visited, anchor, bus, now: nowD, learned });
+    for (const [i, eta] of etas) {
+      if (firedAt[i] == null && eta <= 600) firedAt[i] = sec;
+    }
+  }
+  // Learn from this trip's real legs.
+  for (const [a, b, s] of legs) {
+    const key = segmentKey(route[a], route[b]);
+    const prev = learned.get(key)?.avg_seconds ?? expectedLegSeconds(route, b, learned);
+    const next = learnLeg(prev, s);
+    if (next != null) learned.set(key, { avg_seconds: next });
+  }
+  // Minutes of warning each parent actually got (stops whose true arrival is >10 min in).
+  return route.map((_, i) => i).filter((i) => arriveAt[i] > 660 && firedAt[i] != null)
+    .map((i) => (arriveAt[i] - firedAt[i]) / 60);
+}
+
+const learned = new Map();
+const fmt = (w) => w.map((m) => m.toFixed(1)).join(', ');
+const trip1 = simulate(learned);
+console.log(`  Trip 1 (no history)  — minutes of warning: ${fmt(trip1)}`);
+for (let i = 0; i < 4; i++) simulate(learned);
+const trip6 = simulate(learned);
+console.log(`  Trip 6 (learned)     — minutes of warning: ${fmt(trip6)}`);
+
+test('after learning, every parent gets 9–11 minutes of warning', () => {
+  trip6.forEach((m) => assert.ok(m >= 9 && m <= 11, `got ${m.toFixed(1)} min`));
+});
+
+console.log(`\n${passed} tests passed`);
diff --git a/src/eta/etaCalculator.js b/src/eta/etaCalculator.js
new file mode 100644
index 0000000..cfd39d7
--- /dev/null
+++ b/src/eta/etaCalculator.js
@@ -0,0 +1,154 @@
+import { getDistanceToNextStopInMeters } from '../utils/geoUtils.js';
+
+/**
+ * Pure ETA logic — no database, no network — so it can be unit-tested
+ * (see eta.test.js). etaWorker.js feeds it data and acts on the result.
+ *
+ * A "stop" here is one entry of routes.stop_sequence:
+ *   { sequence, student_ids: [...], lat, lng, baseline_leg_seconds }
+ * baseline_leg_seconds = Mapbox's driving time from the PREVIOUS stop to this
+ * one (no boarding time). The SCHOOL waypoint has student_ids = [].
+ */
+
+export const DEFAULTS = {
+  avgSpeedKmh: 20,        // typical school-bus speed on Kerala roads, incl. junctions
+  maxSpeedKmh: 45,        // physical lower bound: bus can't be faster than this on average
+  roadFactor: 1.4,        // road distance is ~1.4x straight-line distance
+  dwellSeconds: 45,       // boarding/alighting time at each student stop
+  learningRate: 0.3,      // how fast learned times follow new trips (0..1)
+  outlierFactor: 3,       // ignore a leg that took >3x or <1/3 of the expected time
+  arrivalRadiusMeters: 100, // bus within this of a stop = "reached it" (10s pings at ≤36 km/h always land inside)
+};
+
+const toKmhToMps = (kmh) => (kmh * 1000) / 3600;
+
+function dist(a, b) {
+  return getDistanceToNextStopInMeters({ lat: a.lat, lon: a.lng }, { lat: b.lat, lon: b.lng });
+}
+
+/** Stable key for the road between two stops (survives route regeneration). */
+export function segmentKey(from, to) {
+  const r = (n) => Number(n).toFixed(4);
+  return `${r(from.lat)},${r(from.lng)}>${r(to.lat)},${r(to.lng)}`;
+}
+
+/** Normalises old-format stops ({student_id}) and new ones ({student_ids}). */
+export function normaliseStops(stopSequence) {
+  return (stopSequence || []).map((s, i) => ({
+    sequence: s.sequence ?? i,
+    lat: s.lat,
+    lng: s.lng,
+    student_ids: s.student_ids || (s.student_id ? [s.student_id] : []),
+    baseline_leg_seconds: s.baseline_leg_seconds ?? null,
+  }));
+}
+
+/** Rough driving time from a point to a stop using straight-line distance. */
+export function distanceEstimateSeconds(from, to, opts = DEFAULTS) {
+  const d = dist(from, to);
+  if (d == null) return null;
+  return (d * opts.roadFactor) / toKmhToMps(opts.avgSpeedKmh);
+}
+
+/**
+ * Expected seconds from reaching stop k-1 to reaching stop k (boarding time
+ * at k-1 included). Priority: learned average > Mapbox baseline + dwell >
+ * distance estimate + dwell.
+ */
+export function expectedLegSeconds(stops, k, learned, opts = DEFAULTS) {
+  const prev = stops[k - 1];
+  const cur = stops[k];
+  const l = learned?.get(segmentKey(prev, cur));
+  if (l && l.avg_seconds > 0) return l.avg_seconds;
+
+  const dwell = prev.student_ids.length > 0 ? opts.dwellSeconds : 0;
+  if (cur.baseline_leg_seconds != null) return cur.baseline_leg_seconds + dwell;
+  return distanceEstimateSeconds(prev, cur, opts) + dwell;
+}
+
+/**
+ * Returns the index of the nearest not-yet-reached stop within the arrival
+ * radius, or null. Uses GPS position, not the planned order, so a driver who
+ * swaps two stops is still tracked correctly.
+ */
+export function detectArrival(stops, visited, bus, opts = DEFAULTS) {
+  let best = null;
+  let bestD = Infinity;
+  stops.forEach((s, i) => {
+    if (visited[i] != null) return;
+    const d = dist(bus, s);
+    if (d != null && d <= opts.arrivalRadiusMeters && d < bestD) {
+      best = i;
+      bestD = d;
+    }
+  });
+  return best;
+}
+
+/**
+ * ETA in seconds for every not-yet-reached student stop.
+ *
+ * - Stops AFTER the last stop reached: follow the planned order, summing
+ *   expected leg times. For the leg currently being driven, subtract the
+ *   time already spent on it (but never go below what's physically possible).
+ * - Stops BEFORE the last stop reached (driver skipped or reordered): no
+ *   reliable sequence, so use a distance-based estimate.
+ * - ordered=false (no generated route yet): distance-based estimate for all.
+ *
+ * @returns {Map<number, number>} stop index -> eta seconds
+ */
+export function computeEtas({ stops, visited, anchor, bus, now, learned, ordered = true, opts = DEFAULTS }) {
+  const etas = new Map();
+  const isTarget = (i) => stops[i].student_ids.length > 0 && visited[i] == null;
+
+  if (!ordered) {
+    stops.forEach((s, i) => {
+      if (isTarget(i)) etas.set(i, distanceEstimateSeconds(bus, s, opts));
+    });
+    return etas;
+  }
+
+  const a = anchor ? anchor.index : -1;
+
+  // Out-of-order leftovers behind the anchor.
+  for (let i = 0; i <= a; i++) {
+    if (isTarget(i)) etas.set(i, distanceEstimateSeconds(bus, stops[i], opts));
+  }
+
+  const next = a + 1;
+  if (next >= stops.length) return etas;
+
+  // Time to reach the next planned stop.
+  const direct = distanceEstimateSeconds(bus, stops[next], opts);
+  const fastest = (dist(bus, stops[next]) ?? 0) / toKmhToMps(opts.maxSpeedKmh);
+  let t;
+  if (anchor) {
+    const elapsed = (now - anchor.at) / 1000;
+    const left = expectedLegSeconds(stops, next, learned, opts) - elapsed;
+    // Running late (expected time used up) -> fall back to distance estimate.
+    t = left > 0 ? Math.max(left, fastest) : direct;
+  } else {
+    t = direct; // trip just started, no stop reached yet
+  }
+
+  if (isTarget(next)) etas.set(next, t);
+  for (let k = next + 1; k < stops.length; k++) {
+    t += expectedLegSeconds(stops, k, learned, opts);
+    if (isTarget(k)) etas.set(k, t);
+  }
+  return etas;
+}
+
+/**
+ * New learned average after a real leg time, or null if the sample is an
+ * outlier (breakdown, fuel stop, GPS gap) and should be ignored.
+ */
+export function learnLeg(previousAvg, actualSeconds, opts = DEFAULTS) {
+  if (!(actualSeconds > 0)) return null;
+  if (previousAvg > 0) {
+    const ratio = actualSeconds / previousAvg;
+    if (ratio > opts.outlierFactor || ratio < 1 / opts.outlierFactor) return null;
+    return previousAvg + opts.learningRate * (actualSeconds - previousAvg);
+  }
+  return actualSeconds;
+}
