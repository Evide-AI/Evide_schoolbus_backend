# Copy this file to .env and fill in your real values. Never commit .env.

# Supabase project settings (Project Settings -> API in your Supabase dashboard)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Direct Postgres connection string, for pg-boss (Project Settings -> Database -> Connection string -> URI)
# Use the "Session" pooler string if available, not the transaction pooler, since pg-boss holds long-lived connections.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.YOUR-PROJECT-REF.supabase.co:5432/postgres

# GT06 TCP server port (the port your GT06 device will be configured to connect to)
GT06_TCP_PORT=5023

# Express API port
API_PORT=3000

# Mapbox access token (for route generation — Account -> Tokens in your Mapbox dashboard)
MAPBOX_ACCESS_TOKEN=your-mapbox-token-here

# Firebase service account (for push notifications). On the Docker deployment
# this points at the file mounted into the container (see docker-compose.yml).
# Get it: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_SERVICE_ACCOUNT=/app/secrets/serviceAccountKey.json

# CORS: comma-separated list of origins allowed to call the API (the dashboard).
# Example: https://dashboard.evide.in,http://localhost:5173
# Leave empty to allow all (fine for MVP).
ALLOWED_ORIGINS=

# --- "Bus arriving soon" notifications (src/workers/etaWorker.js) ---
# Alert parents when the bus is this many seconds from their child's stop.
ETA_ALERT_SECONDS=600
# Safety net: also alert if the bus is within this distance, whatever the ETA says.
FALLBACK_RADIUS_METERS=500
# Before this hour (IST) a trip is the pickup route; from this hour on, drop.
PICKUP_CUTOFF_HOUR=12
# Only alert while a trip is running (driver Start or auto-detected). Set false to test without trips.
REQUIRE_TRIP_IN_PROGRESS=true

# --- Bus checked empty (src/workers/emptyCheckWorker.js) ---
# Minutes after a school trip ends before staff are alerted that nobody has
# tapped "Bus checked empty" in the driver app.
EMPTY_CHECK_MINUTES=10

# Trip moments that ring the alarm tone in the parent app (comma-separated).
# Default: PROXIMITY_ALARM,ARRIVING_SOON,REACHED_STOP,REACHED_SCHOOL,LEFT_SCHOOL,DROPPED_HOME
# ALARM_KINDS=
